# Copy to deploy/aws/aws.env and fill in values before running deploy.sh
#   cp deploy/aws/aws.env.example deploy/aws/aws.env

# --- AWS account / region (Free Tier eligible regions commonly us-east-1, us-west-2) ---
AWS_REGION=us-east-1
AWS_PROFILE=default

# Unique name prefix for AWS resources (letters, numbers, hyphens)
PROJECT_NAME=santamar

# EC2 Free Tier: t2.micro or t3.micro (750 hrs/mo for 12 months on eligible accounts)
INSTANCE_TYPE=t3.micro

# Ubuntu 22.04 LTS (Jammy) — override AMI if needed for your region
# Leave empty to auto-resolve the latest official Ubuntu 22.04 AMI via SSM
AMI_ID=

# SSH
KEY_NAME=santamar-aws
# Path to private key created/downloaded for KEY_NAME (chmod 400)
SSH_KEY_PATH=$HOME/.ssh/santamar-aws.pem
# Restrict SSH to your IP/CIDR (recommended). Example: 203.0.113.10/32
# Use 0.0.0.0/0 only for short-lived labs.
SSH_CIDR=0.0.0.0/0

# App paths on the instance
REMOTE_USER=ubuntu
REMOTE_APP_DIR=/home/ubuntu/santamar

# Public hostnames (point DNS A records at the Elastic IP after first deploy)
# For a lab without DNS, leave blank — script prints http://EIP:80 URLs.
SITE_DOMAIN=
CMS_DOMAIN=

# Email for Let's Encrypt (required when SITE_DOMAIN and CMS_DOMAIN are set)
LETSENCRYPT_EMAIL=

# Database mode on the single EC2 host:
#   sqlite  — Free Tier friendly (default; lowest RAM)
#   mysql   — installs MariaDB on the same instance (still Free Tier; heavier on t3.micro)
DB_MODE=sqlite

# Frontend public Strapi URL used at `next build` time.
# If CMS_DOMAIN is set, defaults to https://$CMS_DOMAIN
# Otherwise defaults to http://$ELASTIC_IP (set automatically by the script when blank)
NEXT_PUBLIC_STRAPI_URL=

# Seed Strapi content on first boot only (true|false)
SEED_CONTENT=true
