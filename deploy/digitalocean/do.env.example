# Copy to deploy/digitalocean/do.env and fill in values before running deploy.sh
#   cp deploy/digitalocean/do.env.example deploy/digitalocean/do.env

# --- DigitalOcean CLI ---
# Auth once: doctl auth init
# Optional named context: doctl auth init --context santamar
DOCTL_CONTEXT=

# Droplet identity (reused across deploys; created if missing)
DROPLET_NAME=santamar-cms
# Region slug: doctl compute region list
REGION=nyc3
# Size slug: doctl compute size list
# s-1vcpu-1gb (~$6/mo) works with 4GB swap during Strapi build (slower).
# s-1vcpu-2gb (~$12/mo) is safer for builds and costs +$6/mo vs 1GB.
SIZE=s-1vcpu-1gb
# Image: Ubuntu 22.04 LTS
IMAGE=ubuntu-22-04-x64
# Tags applied on create (used for discovery)
TAGS=santamar,cms

# SSH — private key on this machine (chmod 400)
SSH_KEY_PATH=$HOME/.ssh/id_ed25519
# DigitalOcean SSH key fingerprint or numeric ID already uploaded to the account.
# List: doctl compute ssh-key list
# Import: doctl compute ssh-key import santamar --public-key-file ~/.ssh/id_ed25519.pub
DO_SSH_KEY_ID=

# Remote paths
REMOTE_USER=root
REMOTE_APP_DIR=/var/www/santamar-cms

# Public CMS hostname (optional). Point a DNS A record at the droplet IP.
# Leave blank to use http://DROPLET_IP for PUBLIC_URL / NEXT_PUBLIC_STRAPI_URL.
CMS_DOMAIN=
# Email for Let's Encrypt (required when CMS_DOMAIN is set)
LETSENCRYPT_EMAIL=

# Public frontend origin(s) for Strapi CORS (static site uploaded via FTP elsewhere).
# Comma-separated. Example: https://www.example.com,https://example.com
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=

# Seed Strapi on first boot only (true|false). Deploy flips to false after first successful start.
SEED_CONTENT=true

# Hostname written into Site when seeding (public frontend host, no protocol).
# Must match the domain visitors use, or /api/sites/resolve returns 404 and the
# static frontend builds empty/notFound pages.
PRIMARY_HOSTNAME=penthousedepuntasur.example.com
