{
  "collectionName": "components_shared_nav_items",
  "info": {
    "displayName": "Nav Item",
    "description": "Navigation item — page route (multi_page) or section anchor (single_page)",
    "icon": "bulletList"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "targetType": {
      "type": "enumeration",
      "enum": ["page", "section"],
      "default": "page"
    },
    "url": {
      "type": "string"
    },
    "sectionAnchor": {
      "type": "string"
    },
    "page": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::page.page"
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
