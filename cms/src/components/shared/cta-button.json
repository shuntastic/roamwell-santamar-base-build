{
  "collectionName": "components_shared_cta_buttons",
  "info": {
    "displayName": "CTA Button",
    "description": "A single call-to-action button: label, destination, tab behavior, size, and style",
    "icon": "cursor"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 40
    },
    "url": {
      "type": "string",
      "required": true
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "size": {
      "type": "enumeration",
      "enum": ["small", "medium", "large"],
      "default": "medium",
      "required": true
    },
    "style": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "text"],
      "default": "primary",
      "required": true
    }
  }
}
