{
  "collectionName": "components_blocks_image_texts",
  "info": {
    "displayName": "Image & Text",
    "description": "Split layout with one or more images on the left and optional title, subheadline, and copy on the right",
    "icon": "picture"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subheadline": {
      "type": "text"
    },
    "body": {
      "type": "blocks"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "required": true
    },
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "intervalMs": {
      "type": "integer",
      "default": 5000,
      "min": 1000
    }
  }
}
