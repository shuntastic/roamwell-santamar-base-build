# Local development (SQLite)
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodifiedtobemodified12

# SQLite for local; switch to mysql for LAMP production
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Public site origin (CORS). Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Comma-separated extra origins (static LAMP site on www + apex, staging, etc.)
# FRONTEND_URLS=https://www.santamar.example,https://santamar.example

# Public CMS origin behind reverse proxy (leave empty for local http://HOST:PORT)
# PUBLIC_URL=https://cms.santamar.example
PROXY_KOA=true

SEED_CONTENT=true
STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=en

# Hostname for the seeded primary Site (no protocol/port). Used by bootstrap + /sites/resolve.
PRIMARY_HOSTNAME=localhost

# Form notification email (Production Inquiry Form). Sender must be allowed by your mail host.
EMAIL_FROM=no-reply@santamar.example
# SMTP relay (recommended). When SMTP_HOST is empty, Strapi falls back to direct sendmail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Where Provision site writes deployment packs (default: ../sites relative to cms/).
# SITES_ROOT=/var/www/santamar/sites

# ---------------------------------------------------------------------------
# LAMP / MySQL production example (copy into server cms/.env and fill secrets)
# ---------------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=1337
# NODE_ENV=production
# PUBLIC_URL=https://cms.santamar.example
# FRONTEND_URL=https://santamar.example
# PROXY_KOA=true
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=santamar_cms
# DATABASE_USERNAME=santamar
# DATABASE_PASSWORD=change-me
# DATABASE_SSL=false
# SEED_CONTENT=false
# APP_KEYS=generate-four-unique-keys
# API_TOKEN_SALT=generate-unique
# ADMIN_JWT_SECRET=generate-unique
# TRANSFER_TOKEN_SALT=generate-unique
# JWT_SECRET=generate-unique
# ENCRYPTION_KEY=generate-32-char-secret!!
