# Development
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Show the floating theme switcher while developing (Alt+Shift+T toggles)
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=true

# ---------------------------------------------------------------------------
# Production (LAMP) — set at build time; NEXT_PUBLIC_* is inlined into the bundle
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRAPI_URL=https://cms.santamar.example
# NEXT_PUBLIC_ENABLE_THEME_SWITCHER=false
# HOSTNAME=127.0.0.1
# PORT=3000
