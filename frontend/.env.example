# Development
# Prefer 127.0.0.1 over localhost — Strapi usually listens on IPv4 only.
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
NEXT_PUBLIC_DEFAULT_LOCALE=en
# Show the floating theme switcher while developing (Alt+Shift+T toggles)
NEXT_PUBLIC_ENABLE_THEME_SWITCHER=true

# Multi-site: Host is resolved at runtime (Node). In development, unknown hosts
# fall back to the primary Site. Set SITE_FALLBACK_PRIMARY=true to force that
# behavior in production as well.
# SITE_FALLBACK_PRIMARY=true

# ---------------------------------------------------------------------------
# Production — Node (`next start` behind reverse proxy)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_STRAPI_URL=https://cms.santamar.example
# NEXT_PUBLIC_ENABLE_THEME_SWITCHER=false
# HOSTNAME=127.0.0.1
# PORT=3000

# ---------------------------------------------------------------------------
# Production — Static LAMP DocumentRoot
# Remote CMS:  npm run build:static   (NEXT_PUBLIC_STRAPI_URL = public CMS)
# Local CMS:   npm run build:web:static:local
#              (reads the laptop Strapi and copies cms/public/uploads into out/)
# One static build = one site: set SITE_HOSTNAME and/or SITE_KEY at build time.
# For the local command, pin with SITE_KEY or LAMP_SITE_HOSTNAME.
# ---------------------------------------------------------------------------
# STATIC_EXPORT=true
# SITE_KEY=santamar
# SITE_HOSTNAME=www.santamar.example
# NEXT_PUBLIC_STRAPI_URL=https://cms.santamar.example
# NEXT_PUBLIC_ENABLE_THEME_SWITCHER=false

# Comma-separated host suffixes allowed for CMS-pasted embed <script src>.
# Default (when unset): cloudfront.net (Hostaway widgets).
# NEXT_PUBLIC_EMBED_SCRIPT_ALLOWLIST=cloudfront.net
