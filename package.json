{
  "name": "santamar",
  "private": true,
  "description": "Santa Mar website framework — Next.js frontend + Strapi CMS",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:cms": "npm run develop --prefix cms",
    "dev:web": "npm run dev --prefix frontend",
    "dev:all": "bash scripts/dev.sh --storybook",
    "build:cms": "npm run build --prefix cms",
    "build:web": "npm run build --prefix frontend",
    "build:web:static": "npm run build:static --prefix frontend",
    "build:web:static:local": "bash deploy/lamp-static/build-local.sh",
    "start:cms": "npm run start --prefix cms",
    "start:web": "npm run start --prefix frontend",
    "storybook": "npm run storybook --prefix frontend",
    "deploy:do-cms": "bash deploy/digitalocean/deploy.sh"
  }
}
